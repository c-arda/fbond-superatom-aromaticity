{
  "taskGroups": [
    {
      "taskSpec": {
        "runnables": [
          {
            "container": {
              "imageUri": "__IMAGE_URI__",
              "commands": [
                "--system-file", "/app/geometries/__SYSTEM_NAME__.json",
                "--output-dir", "/mnt/disks/output",
                "--checkpoint-dir", "/mnt/disks/checkpoints",
                "--scratch-dir", "/mnt/disks/scratch",
                "--basis", "__BASIS__"
              ],
              "volumes": [
                "/mnt/disks/output:/mnt/disks/output:rw",
                "/mnt/disks/checkpoints:/mnt/disks/checkpoints:rw",
                "/mnt/disks/scratch:/mnt/disks/scratch:rw"
              ]
            }
          }
        ],
        "computeResource": {
          "cpuMilli": 16000,
          "memoryMib": 122880
        },
        "volumes": [
          {
            "gcs": {
              "remotePath": "__RESULTS_BUCKET__"
            },
            "mountPath": "/mnt/disks/output"
          },
          {
            "gcs": {
              "remotePath": "__CHECKPOINTS_BUCKET__"
            },
            "mountPath": "/mnt/disks/checkpoints"
          },
          {
            "deviceName": "scratch-ssd",
            "mountPath": "/mnt/disks/scratch",
            "mountOptions": ["rw"]
          }
        ],
        "maxRunDuration": "259200s",
        "maxRetryCount": 3
      },
      "taskCount": 1,
      "parallelism": 1
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "__MACHINE_TYPE__",
          "provisioningModel": "SPOT",
          "disks": [
            {
              "newDisk": {
                "type": "pd-ssd",
                "sizeGb": 200
              },
              "deviceName": "scratch-ssd"
            }
          ]
        }
      }
    ],
    "location": {
      "allowedLocations": [
        "zones/us-central1-a",
        "zones/us-central1-b",
        "zones/us-central1-c",
        "zones/us-central1-f"
      ]
    }
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
